[Unit]
Description=IgH EtherCAT Diagnostics
Requires=ethercat.service
After=ethercat.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/igh-ethercat-diagnostics
StateDirectory=igh-ethercat-diagnostics
WorkingDirectory=/var/lib/igh-ethercat-diagnostics
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target